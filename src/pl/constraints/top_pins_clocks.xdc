
# ad9371
set_property -dict {PACKAGE_PIN AD10} [get_ports qpll_refclk_p]
set_property -dict {PACKAGE_PIN AD9} [get_ports qpll_refclk_n]
set_property -dict {PACKAGE_PIN AA8} [get_ports cpll_refclk_p]
set_property -dict {PACKAGE_PIN AA7} [get_ports cpll_refclk_n]
set_property -dict {PACKAGE_PIN AJ8} [get_ports {rxp_in[0]}]
set_property -dict {PACKAGE_PIN AJ7} [get_ports {rxn_in[0]}]
set_property -dict {PACKAGE_PIN AG8} [get_ports {rxp_in[1]}]
set_property -dict {PACKAGE_PIN AG7} [get_ports {rxn_in[1]}]
set_property -dict {PACKAGE_PIN AH10} [get_ports {rxp_in[2]}]
set_property -dict {PACKAGE_PIN AH9} [get_ports {rxn_in[2]}]
set_property -dict {PACKAGE_PIN AE8} [get_ports {rxp_in[3]}]
set_property -dict {PACKAGE_PIN AE7} [get_ports {rxn_in[3]}]
set_property -dict {PACKAGE_PIN AK6} [get_ports {txp_out[0]}]
set_property -dict {PACKAGE_PIN AK5} [get_ports {txn_out[0]}]
set_property -dict {PACKAGE_PIN AJ4} [get_ports {txp_out[1]}]
set_property -dict {PACKAGE_PIN AJ3} [get_ports {txn_out[1]}]
set_property -dict {PACKAGE_PIN AK10} [get_ports {txp_out[2]}]
set_property -dict {PACKAGE_PIN AK9} [get_ports {txn_out[2]}]
set_property -dict {PACKAGE_PIN AK2} [get_ports {txp_out[3]}]
set_property -dict {PACKAGE_PIN AK1} [get_ports {txn_out[3]}]
set_property -dict {PACKAGE_PIN AJ28 IOSTANDARD LVDS_25} [get_ports rx_sync_p]
set_property -dict {PACKAGE_PIN AJ29 IOSTANDARD LVDS_25} [get_ports rx_sync_n]
set_property -dict {PACKAGE_PIN R27 IOSTANDARD LVDS_25} [get_ports rx_os_sync_p]
set_property -dict {PACKAGE_PIN T27 IOSTANDARD LVDS_25} [get_ports rx_os_sync_n]
set_property -dict {PACKAGE_PIN AK27 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports tx_sync_p]
set_property -dict {PACKAGE_PIN AK28 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports tx_sync_n]
set_property -dict {PACKAGE_PIN P30 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports sysref_p]
set_property -dict {PACKAGE_PIN R30 IOSTANDARD LVDS_25 DIFF_TERM 1} [get_ports sysref_n]

set_property -dict {PACKAGE_PIN AG29 IOSTANDARD LVCMOS25} [get_ports spi_csn_ad9528]
set_property -dict {PACKAGE_PIN AF29 IOSTANDARD LVCMOS25} [get_ports spi_csn_ad9371]
set_property -dict {PACKAGE_PIN AD30 IOSTANDARD LVCMOS25} [get_ports spi_clk]
set_property -dict {PACKAGE_PIN AE30 IOSTANDARD LVCMOS25} [get_ports spi_mosi]
set_property -dict {PACKAGE_PIN AF30 IOSTANDARD LVCMOS25} [get_ports spi_miso]

set_property -dict {PACKAGE_PIN T30 IOSTANDARD LVCMOS25} [get_ports ad9528_reset_b]
set_property -dict {PACKAGE_PIN U30 IOSTANDARD LVCMOS25} [get_ports ad9528_sysref_req]
set_property -dict {PACKAGE_PIN AE25 IOSTANDARD LVCMOS25} [get_ports ad9371_tx1_enable]
set_property -dict {PACKAGE_PIN AB29 IOSTANDARD LVCMOS25} [get_ports ad9371_tx2_enable]
set_property -dict {PACKAGE_PIN AF25 IOSTANDARD LVCMOS25} [get_ports ad9371_rx1_enable]
set_property -dict {PACKAGE_PIN AB30 IOSTANDARD LVCMOS25} [get_ports ad9371_rx2_enable]
set_property -dict {PACKAGE_PIN AG26 IOSTANDARD LVCMOS25} [get_ports ad9371_test]
set_property -dict {PACKAGE_PIN AH26 IOSTANDARD LVCMOS25} [get_ports ad9371_reset_b]
set_property -dict {PACKAGE_PIN AH27 IOSTANDARD LVCMOS25} [get_ports ad9371_gpint]

# clocks
create_clock -period 8.138 -name tx_ref_clk [get_ports qpll_refclk_p]
create_clock -period 8.138 -name rx_ref_clk [get_ports cpll_refclk_p]

 
