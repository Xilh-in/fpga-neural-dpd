# DPD whole-design integration flow for Vivado 2025.2.
# Source this file from a fresh Vivado GUI with no project open.
# Existing user projects and original inputs are never overwritten.

# "route" runs synthesis, IP insertion, optimization, placement and routing.
# Set to "synth" only if you want to stop after complete netlist assembly.
set dpd_run_to route

# Set to 1 to save intermediate/final design checkpoints.
# No bitstream is generated by this script, with either setting.
set dpd_save_checkpoints 0

set dpd_package_root [file dirname [file normalize [info script]]]
source [file join $dpd_package_root inputs.tcl]

if {[string first "2025.2" [version -short]] != 0} {
    error "This package targets Vivado 2025.2. Current version: [version -short]"
}
if {[llength [get_projects -quiet]] != 0} {
    error "Use a fresh Vivado window with no project open, then source this file again."
}
if {$dpd_run_to ni {synth route}} {
    error "dpd_run_to must be synth or route."
}

# Lightweight input checks happen automatically; no manual checkpoint tests.
set dpd_required $dpd_rtl_files
lappend dpd_required legacy/hdl/system.v legacy/hdl/system_wrapper.v
lappend dpd_required constraints/top_pins_clocks.xdc constraints/clock_exceptions.xdc
foreach entry $dpd_ip_entries {
    lappend dpd_required [lindex $entry 1] [lindex $entry 2]
}
foreach relative $dpd_required {
    if {![file isfile [file join $dpd_package_root $relative]]} {
        error "Missing package input: $relative"
    }
}

set dpd_out [file join $dpd_package_root build [clock format [clock seconds] -format {%Y%m%d_%H%M%S}]]
set dpd_suffix 0
set dpd_base_out $dpd_out
while {[file exists $dpd_out]} {
    incr dpd_suffix
    set dpd_out ${dpd_base_out}_$dpd_suffix
}
file mkdir $dpd_out
set dpd_previous_cwd [pwd]
cd $dpd_out
set dpd_stage INIT

proc dpd_step {name body} {
    set ::dpd_stage $name
    puts "\n===== DPD STAGE: $name ====="
    uplevel 1 $body
}

proc dpd_checkpoint {filename} {
    if {$::dpd_save_checkpoints} {
        write_checkpoint [file join $::dpd_out $filename]
    }
}

set dpd_rc [catch {
    dpd_step 01_read_sources {
        create_project -in_memory dpd_netlist -part xc7z100ffg900-2
        set_property target_language Verilog [current_project]
        set_property top jesd204b_adc_dac_top [current_fileset]
        set dpd_hdl {}
        foreach relative $dpd_rtl_files {
            lappend dpd_hdl [file join $dpd_package_root $relative]
        }
        lappend dpd_hdl [file join $dpd_package_root legacy/hdl/system.v]
        lappend dpd_hdl [file join $dpd_package_root legacy/hdl/system_wrapper.v]
        foreach entry $dpd_ip_entries {
            lappend dpd_hdl [file join $dpd_package_root [lindex $entry 2]]
        }
        read_verilog -sv $dpd_hdl
        read_xdc [file join $dpd_package_root constraints/top_pins_clocks.xdc]
        puts "Inputs: 19 selected RTL files, 2 generated system HDL files, 14 IP stubs."
    }

    dpd_step 02_synth_rtl {
        # Preserve hierarchy so IP netlists can be inserted into their instances.
        synth_design -top jesd204b_adc_dac_top -part xc7z100ffg900-2 -flatten_hierarchy none
        dpd_checkpoint 10_rtl_with_ip_blackboxes.dcp
    }

    dpd_step 03_insert_ip_netlists {
        set dpd_checkpoint_by_ref [dict create]
        foreach entry $dpd_ip_entries {
            dict set dpd_checkpoint_by_ref [lindex $entry 0] [file join $dpd_package_root [lindex $entry 1]]
        }
        set dpd_blackbox_names {}
        foreach cell [get_cells -hierarchical -quiet -filter {IS_BLACKBOX == 1}] {
            lappend dpd_blackbox_names [get_property NAME $cell]
        }
        puts "IP instances awaiting insertion: [llength $dpd_blackbox_names]"
        if {[llength $dpd_blackbox_names] == 0} {
            error "No IP blackboxes survived synthesis. Inspect the synthesis log before treating this as a complete design."
        }
        foreach cellname $dpd_blackbox_names {
            set cell [get_cells $cellname]
            set ref [get_property REF_NAME $cell]
            if {![dict exists $dpd_checkpoint_by_ref $ref]} {
                error "No supplied checkpoint matches blackbox $cellname (REF_NAME=$ref)."
            }
            set checkpoint [dict get $dpd_checkpoint_by_ref $ref]
            puts "INSERT: $cellname <- $ref"
            read_checkpoint -cell $cellname $checkpoint
        }
        set dpd_remaining [get_cells -hierarchical -quiet -filter {IS_BLACKBOX == 1}]
        puts "BLACKBOXES_AFTER_INSERT = [llength $dpd_remaining]"
        if {[llength $dpd_remaining] != 0} {
            error "Unresolved blackboxes remain: $dpd_remaining"
        }
        # Generated clock names are available only after their IP is inserted.
        set ps_fclk_pin [get_pins {system_wrapper_inst/system_i/processing_system7_0/inst/PS7_i/FCLKCLK[0]}]

        if {[llength $ps_fclk_pin] != 1} {
            error "Cannot uniquely locate PS FCLK_CLK0."
        }

        create_clock -name clk_fpga_0 -period 10.000 $ps_fclk_pin
        set_input_jitter [get_clocks clk_fpga_0] 0.300
        read_xdc [file join $dpd_package_root constraints/clock_exceptions.xdc]
        dpd_checkpoint 20_linked_design.dcp
        report_utilization -file [file join $dpd_out utilization_linked.rpt]
        report_clocks -file [file join $dpd_out clocks_linked.rpt]
    }

    if {$dpd_run_to eq "route"} {
        dpd_step 04_optimize {
            opt_design
            dpd_checkpoint 30_optimized.dcp
        }
        dpd_step 05_place {
            place_design
            dpd_checkpoint 40_placed.dcp
        }
        # Recovered successful timing_opt_3 recipe: start from placement,
        # optimize fanout, then route with Explore. The earlier post-route
        # Explore/AggressiveExplore attempts are not prerequisites.
        dpd_step 06_phys_opt {
            phys_opt_design -directive AggressiveFanoutOpt
            dpd_checkpoint 45_fanout_optimized.dcp
        }
        dpd_step 07_route {
            route_design -directive Explore
            dpd_checkpoint 50_routed.dcp
        }
        dpd_step 08_reports {
            report_timing_summary -file [file join $dpd_out timing_summary_routed.rpt]
            report_route_status -file [file join $dpd_out route_status.rpt]
            report_drc -file [file join $dpd_out drc_routed.rpt]
            report_utilization -file [file join $dpd_out utilization_routed.rpt]
        }
        dpd_step 09_check_timing {
            set timing_file [open [file join $dpd_out timing_summary_routed.rpt] r]
            set timing_text [read $timing_file]
            close $timing_file
            if {[string first {All user specified timing constraints are met.} $timing_text] < 0} {
                error "Timing report did not confirm closure. Inspect timing_summary_routed.rpt; reports have been retained."
            }
            puts "TIMING_CONSTRAINTS_MET=YES"
        }
    }
} dpd_error dpd_options]

cd $dpd_previous_cwd
if {$dpd_rc != 0} {
    set f [open [file join $dpd_out failed.txt] w]
    puts $f "STAGE=$dpd_stage"
    puts $f "ERROR=$dpd_error"
    if {[dict exists $dpd_options -errorinfo]} {
        puts $f [dict get $dpd_options -errorinfo]
    }
    close $f
    puts "\nDPD_BUILD_FAILED"
    puts "STAGE=$dpd_stage"
    puts "OUTPUT_DIR=$dpd_out"
    puts "ERROR=$dpd_error"
    return -options $dpd_options $dpd_error
}

set f [open [file join $dpd_out completed.txt] w]
puts $f "COMPLETED_STAGE=$dpd_run_to"
puts $f "TOOL=[version -short]"
puts $f "PART=xc7z100ffg900-2"
puts $f "CURRENT_RTL=dpd_ip_v1"
puts $f "LEGACY_IP_SOURCE=Vivado 2021.1 OOC DCPs"
puts $f "SAVE_CHECKPOINTS=$dpd_save_checkpoints"
if {$dpd_run_to eq "route"} {
    puts $f "PHYS_OPT_DIRECTIVE=AggressiveFanoutOpt"
    puts $f "ROUTE_DIRECTIVE=Explore"
    puts $f "TIMING_CONSTRAINTS_MET=YES"
}
puts $f "Timing status applies to the supplied constraints only. Review constraint coverage and DRC separately."
puts $f "This result does not establish board-level functionality or licensing for bitstream generation."
close $f
puts "\nDPD_BUILD_COMPLETED"
puts "COMPLETED_STAGE=$dpd_run_to"
puts "OUTPUT_DIR=$dpd_out"
puts "No bitstream was generated and no hardware was programmed."
